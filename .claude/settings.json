{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git reset --hard*)",
      "Bash(git *reset *--hard*)",
      "Bash(git clean* -f*)",
      "Bash(git clean* --force*)",
      "Bash(sudo *)",
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "PowerShell(Remove-Item *-Recurse*)",
      "PowerShell(Remove-Item * -r*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * +*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean* -f*)",
      "PowerShell(git clean* --force*)"
    ]
  }
}
