func _init() -> void:
	for nome in ARTE:
		var a: Dictionary = ARTE[nome]
		if a.tipo == "molde":
			continue
		var grade: Array = ARTE[a.base].grade if a.has("base") else a.grade
		var troca: Dictionary = a.get("troca", {})
		var w: int = grade[0].length()
		var h: int = grade.size()
		var img := Image.create(w, h, false, Image.FORMAT_RGBA8)
		for y in h:
			var linha: String = grade[y]
			assert(linha.length() == w, "%s: linha %d tem %d colunas (esperava %d)" % [nome, y, linha.length(), w])
			for x in w:
				var ch: String = troca.get(linha[x], linha[x])
				if ch != ".":
					img.set_pixel(x, y, Color(COR[ch]))
		var cheio := []   # contorno: vizinho (4 direções) vazio de um pixel cheio vira "k"
		for y in h:
			for x in w:
				cheio.append(img.get_pixel(x, y).a > 0.5)
		for y in h:
			for x in w:
				if cheio[y * w + x]:
					continue
				for v in [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1)]:
					var q: Vector2i = Vector2i(x, y) + v
					if q.x >= 0 and q.y >= 0 and q.x < w and q.y < h and cheio[q.y * w + q.x]:
						img.set_pixel(x, y, Color(COR.k))
						break
		var caminho := "res://assets/gerado/%s.png" % (("icone_" + nome) if a.tipo == "icone" else nome)
		img.save_png(caminho)
		print("ARTE ", nome, " ", w, "x", h)
	quit()
