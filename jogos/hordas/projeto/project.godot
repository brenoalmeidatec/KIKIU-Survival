; Engine configuration file.
config_version=5

[application]

config/name="K.I.K.I.U"
config/description="Knights In Kaos, Infinite Upgrades: sobreviva à horda e vença o duelo final."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[autoload]

Dados="*res://scripts/hordas/dados.gd"
Som="*res://scripts/hordas/som.gd"
Rede="*res://scripts/hordas/rede.gd"
Config="*res://scripts/hordas/config.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

theme/custom_font="res://assets/fonte/PressStart2P.ttf"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.1, 0.09, 0.12, 1)
